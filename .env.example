# =============================================================================
# Smart Traffic Management System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Driver: "sqlite" for local dev (no setup needed), "postgresql" for production
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_DATABASE=stms_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# --- Server Ports ---
API_PORT=8001

# --- CORS ---
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900
